# =============================================================================
# Enterprise MCP Gateway Environment Configuration Template
# =============================================================================

# Google Cloud Platform Project & Region
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=europe-west1
PORT=3000
NODE_ENV=development

# Cloud Firestore Backend & Connector (Optional)
# Options: '(default)' for standard single-database, or custom named database (e.g. 'mcp-gateway-db')
FIRESTORE_DATABASE_ID=(default)
FIRESTORE_ALLOWED_COLLECTIONS=*
FIRESTORE_ALLOW_WRITES=false

# Google Workspace Identity & Domain Authorization
ALLOWED_EMAIL_DOMAINS=yourcompany.com
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# MCP Gateway & Gemini Enterprise OAuth 2.0 PKCE Credentials
# (These are automatically provisioned into Google Cloud Secret Manager)
MCP_CLIENT_ID=gemini-enterprise-mcp
MCP_CLIENT_SECRET=
MCP_JWT_SECRET=
MCP_SETUP_TOKEN=

# BigQuery Connector (Optional)
BIGQUERY_PROJECT_ID=
BIGQUERY_LOCATION=EU
BIGQUERY_DEFAULT_DATASET=
BIGQUERY_ALLOWED_TABLES=*
BIGQUERY_MAX_BYTES_BILLED=1073741824
BIGQUERY_MAX_ROWS_RETURNED=100

# Xero Connector (Optional)
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_TENANT_ID=

# Sage HR Connector (Optional)
SAGE_HR_API_KEY=
SAGE_HR_SUBDOMAIN=

# Slack Federated Search Connector (Optional)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://your-cloud-run-url/api/connectors/slack/callback

# Optional Domain Enablement Filter
# Comma-separated list of enabled domains: xero,bigquery,firestore,sagehr,slack
# If left unset or empty, all domains are enabled by default.
ENABLED_DOMAINS=

# Optional Logging Configuration
LOG_LEVEL=info
